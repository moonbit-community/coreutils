import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/queue",
  "moonbitlang/x/fs",
}

supported_targets = "native"

options(
  "is-main": true,
  targets: {
    "read_char_native.mbt": [ "native", "llvm" ],
    "read_char_wasm.mbt": [ "not", "native", "llvm" ],
  },
)
